# Copy to .env and run: node --env-file=.env server.js
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Set to the real HTTPS origin when deployed. No trailing slash or subpath.
# PUBLIC_ORIGIN=https://slides.example.com
# Required on a public deployment; share with people allowed to upload.
# UPLOAD_KEY=replace-with-a-long-random-key
# 0 retains files until explicitly deleted; 1..365 enables automatic expiry.
RETENTION_DAYS=0
MAX_DECKS=100
